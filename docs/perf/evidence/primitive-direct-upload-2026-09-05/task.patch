+import System.Collections.Generic
+import System.IO
+import Goo
+
+class DirectPrimitiveUploadCell : Cell {
+  private var count int32 = 4
+  private var mutated bool
+
+  internal func Mutate() {
+    mutated = true
+    Rebuild()
+  }
+
+  internal func Grow() {
+    count = 48
+    Rebuild()
+  }
+
+  internal func Touch() {
+    Rebuild()
+  }
+
+  override func Build() Blob {
+    let children = List[Blob](count)
+    var index int32
+    while index < count {
+      let column = index % 12
+      let row = index / 12
+      let color = if index == 0 && mutated {
+        Color.Rgb(231, 93, 41)
+      } else {
+        Color.Rgb(42, 112, 218)
+      }
+      children.Add(Container{
+        Position: PositionType.Absolute,
+        Left: 8.0 + float64(column) * 12.0,
+        Top: 8.0 + float64(row) * 12.0,
+        Width: 10,
+        Height: 10,
+        BackgroundColor: color,
+      })
+      index++
+    }
+    return Container{
+      Position: PositionType.Relative,
+      Width: Length.Percent(100),
+      Height: Length.Percent(100),
+      BackgroundColor: Color.Transparent,
+      Children: children,
+    }
+  }
+}
+
+func DirectPrimitiveRequireMode(stats VulkanPrimitiveFrameRetentionTestSnapshot,
+  label string) {
+    Require(stats.RequestedUploadMode == VulkanPrimitiveUploadMode.Direct
+        && stats.UploadMode == VulkanPrimitiveUploadMode.Direct
+        && stats.UploadFallback == VulkanPrimitiveUploadFallback.None,
+      label + " did not select direct upload")
+    Require(stats.PlannedTransferBytes == 0uL
+        && stats.SubmittedTransferBytes == 0uL
+        && stats.UploadRangeCount == 0
+        && stats.RecordedCopyCommands == 0uL
+        && stats.RecordedBarriers == 0uL,
+      label + " recorded staged transfer work")
+    Require(stats.CpuWrittenBytes == uint64(stats.RecordCount) * 128uL
+        && stats.CpuWriteOperations == uint64(stats.RecordCount)
+        && stats.RequestedFlushBytes == stats.CpuWrittenBytes
+        && stats.FlushRequests == 1uL,
+      label + " direct mapped write or flush coverage is incorrect")
+  }
+
+func RunDirectPrimitiveUploadSmoke() {
+  Require(Environment.GetEnvironmentVariable("GOO_VK_DIAGNOSTICS") == "1",
+    "GOO_VK_DIAGNOSTICS=1 is required")
+  let previousMode = Environment.GetEnvironmentVariable("GOO_PRIMITIVE_UPLOAD_MODE")
+  let originalError = Console.Error
+  let capturedError = StringWriter()
+  let root = DirectPrimitiveUploadCell{}
+  var window Window? = nil
+  try {
+    Environment.SetEnvironmentVariable("GOO_PRIMITIVE_UPLOAD_MODE", "direct")
+    let opened = Window{
+      Title: "Goo direct primitive upload",
+      Width: 160,
+      Height: 80,
+      VSync: false,
+      Background: Color.Transparent,
+      Root: root,
+    }
+    window = opened
+    Console.SetError(capturedError)
+    opened.Open()
+    WindowReadbackTestFixture.ForceRender(opened, 0.0)
+    let initial = WindowReadbackTestFixture.PrimitiveFrameRetention(opened)
+    DirectPrimitiveRequireMode(initial, "initial")
+    Require(initial.RecordCount == 4 && initial.FullUpload
+        && initial.DirtyRecordCount == initial.RecordCount,
+      "Direct initial upload did not publish all records: records="
+      +initial.RecordCount.ToString() + " dirty=" + initial.DirtyRecordCount.ToString()
+      +" full=" + initial.FullUpload.ToString())
+    let initialStorage = WindowReadbackTestFixture.DirectStorage(opened)
+    Require(initialStorage.DestinationPresent && initialStorage.DestinationMapped
+        && !initialStorage.StagingPresent && !initialStorage.StagingMapped
+        && initialStorage.BufferGeneration > 0uL,
+      "Direct upload retained a staging resource or lacked mapped destination storage")
+
+    for index in 0 ... 4 {
+      WindowReadbackTestFixture.ForceRender(opened, 0.0166666666666667)
+    }
+    let unchanged = WindowReadbackTestFixture.PrimitiveFrameRetention(opened)
+    DirectPrimitiveRequireMode(unchanged, "unchanged")
+    Require(!unchanged.FullUpload && unchanged.DirtyRecordCount == 0
+        && unchanged.CpuComparedBytes == unchanged.ByteCount,
+      "Direct unchanged frame did not compare cleanly")
+
+    let emulateNoncoherent = initialStorage.HostCoherent
+    let changedAllocations = if emulateNoncoherent {
+      WindowReadbackTestFixture.SetDirectHostCoherent(opened, false)
+    } else {
+      0
+    }
+    Require(!emulateNoncoherent || changedAllocations > 0,
+      "Direct noncoherent bookkeeping fixture found no mapped destination")
+    try {
+      root.Touch()
+      WindowReadbackTestFixture.ForceRender(opened, 0.0166666666666667)
+      let emulatedNoncoherent = WindowReadbackTestFixture.PrimitiveFrameRetention(opened)
+      DirectPrimitiveRequireMode(emulatedNoncoherent, "noncoherent bookkeeping")
+      Require(emulatedNoncoherent.NativeFlushCalls == 1uL,
+        "Direct noncoherent bookkeeping did not execute its native flush branch")
+    } finally {
+      if emulateNoncoherent {
+        WindowReadbackTestFixture.SetDirectHostCoherent(opened, true)
+      }
+    }
+
+    let abort = WindowReadbackTestFixture.DirectAbortHistory(opened)
+    Require(abort.SeedHistoryValid && abort.SeedHistoryRecordCount == 2
+        && abort.SeedHistoryEffectDataOffset == 256uL
+        && abort.SeedHistoryEffectDataVersion == 123uL
+        && abort.SeedHistoryBufferGeneration > 0uL,
+      "Direct abort fixture did not seed submitted history")
+    Require(!abort.AbortedHistoryValid && abort.AbortedHistoryEffectDataVersion == 0uL,
+      "Direct abort retained candidate history")
+    Require(abort.RecoveryFullUpload && abort.RecoveryRecordCount == 1
+        && abort.RecoveryCpuWrittenBytes == 136uL
+        && abort.RecoveryRequestedFlushBytes == 136uL
+        && abort.RecoverySentinelZero && abort.RecoveryEffectDataMatched,
+      "Direct abort recovery did not rewrite the sentinel and same-version effect tail")
+
+    for index in 0 ... 4 {
+      WindowReadbackTestFixture.ForceRender(opened, 0.0166666666666667)
+    }
+
+    root.Mutate()
+    WindowReadbackTestFixture.ForceRender(opened, 0.0166666666666667)
+    let sparse = WindowReadbackTestFixture.PrimitiveFrameRetention(opened)
+    DirectPrimitiveRequireMode(sparse, "sparse")
+    Require(sparse.DirtyRecordCount == 1 && !sparse.FullUpload,
+      "Direct sparse mutation did not preserve record history")
+    let metrics = WindowReadbackTestFixture.Metrics(opened)
+    let sparsePixels = PrimitiveReadback(opened, metrics)
+    PrimitiveRequirePixelNear(sparsePixels.Pixels, sparsePixels.Width, metrics,
+      12.0, 12.0, uint8(231), uint8(93), uint8(41), 8, "direct_sparse")
+
+    let capacityBeforeGrowth = sparse.Capacity
+    root.Grow()
+    WindowReadbackTestFixture.ForceRender(opened, 0.0166666666666667)
+    let growth = WindowReadbackTestFixture.PrimitiveFrameRetention(opened)
+    DirectPrimitiveRequireMode(growth, "growth")
+    Require(growth.RecordCount == 48 && growth.FullUpload
+        && growth.DirtyRecordCount == growth.RecordCount
+        && growth.Capacity > capacityBeforeGrowth,
+      "Direct growth did not replace and fully populate destination storage: initial_records="
+      +initial.RecordCount.ToString() + " growth_records=" + growth.RecordCount.ToString()
+      +" dirty=" + growth.DirtyRecordCount.ToString() + " full="
+      +growth.FullUpload.ToString() + " capacity_before="
+      +capacityBeforeGrowth.ToString() + " capacity_after=" + growth.Capacity.ToString())
+    let growthStorage = WindowReadbackTestFixture.DirectStorage(opened)
+    Require(growthStorage.DestinationMapped && !growthStorage.StagingPresent
+        && growthStorage.BufferGeneration > initialStorage.BufferGeneration,
+      "Direct growth did not advance destination buffer generation")
+    let growthPixels = PrimitiveReadback(opened, metrics)
+    PrimitiveRequirePixelNear(growthPixels.Pixels, growthPixels.Width, metrics,
+      12.0, 12.0, uint8(231), uint8(93), uint8(41), 8, "direct_growth_mutated")
+    PrimitiveRequirePixelNear(growthPixels.Pixels, growthPixels.Width, metrics,
+      144.0, 48.0, uint8(42), uint8(112), uint8(218), 8, "direct_growth_tail")
+
+    let capability = WindowReadbackTestFixture.DirectCapability(opened)
+    Require(capability.DirectRejected && capability.AllocationFailurePropagated
+        && capability.CleanupBalanced,
+      "Direct capability or post-selection allocation failure contract is incorrect")
+    if capability.FullFallbackAvailable {
+      Require(capability.RequestedUploadMode == VulkanPrimitiveUploadMode.Direct
+          && capability.UploadMode == VulkanPrimitiveUploadMode.Staged
+          && capability.UploadFallback
+        == VulkanPrimitiveUploadFallback.MissingCompatibleMemory,
+        "Direct capability miss did not select staged fallback")
+    }
+    opened.RequestClose()
+    WindowReadbackTestFixture.ForceRender(opened, 0.0)
+    Require(!opened.IsOpen
+        && WindowReadbackTestFixture.ResidentResourceBytes(opened) == 0uL,
+      "Direct upload resources remain resident after close")
+    ReadbackValidateCommonDiagnostics(capturedError.ToString())
+    Console.WriteLine("direct-primitive-upload-smoke: staged_resources=0 transfers=0"
+      +" noncoherent=" + (emulateNoncoherent ? "emulated" : "native")
+      +" abort_recovery=1 growth=1 pixels=1 fallback="
+      +(capability.FullFallbackAvailable ? "staged" : "hardware_unavailable")
+      +" allocation_failure=propagated cleanup=1")
+  } catch (error Exception) {
+    Console.SetError(originalError)
+    Console.Error.Write(capturedError.ToString())
+    throw error
+  } finally {
+    if let opened = window {
+      if opened.IsOpen {
+        opened.RequestClose()
+        WindowReadbackTestFixture.ForceRender(opened, 0.0)
+      }
+    }
+    Console.SetError(originalError)
+    Environment.SetEnvironmentVariable("GOO_PRIMITIVE_UPLOAD_MODE", previousMode)
+  }
+}
