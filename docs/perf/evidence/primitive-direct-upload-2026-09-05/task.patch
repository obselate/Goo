+internal unsafe partial class VulkanMemoryAllocator {
+  shared {
+    internal func WithoutDirectMemoryForTest(
+      properties VkPhysicalDeviceMemoryProperties) VkPhysicalDeviceMemoryProperties{
+        let filtered = properties
+        let memoryTypes = *VkMemoryType(nint(&filtered.memoryTypes_0))
+        var index int32
+        let directFlags = uint32(VkConstants.VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)
+        | uint32(VkConstants.VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)
+        while index < int32(filtered.memoryTypeCount) {
+          if (memoryTypes[index].propertyFlags & directFlags) == directFlags {
+            memoryTypes[index].propertyFlags = memoryTypes[index].propertyFlags
+            ^uint32(VkConstants.VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)
+          }
+          index++
+        }
+        return filtered
+      }
+
+    internal func HasHostVisibleMemoryForTest(
+      properties VkPhysicalDeviceMemoryProperties) bool{
+        let copied = properties
+        let memoryTypes = *VkMemoryType(nint(&copied.memoryTypes_0))
+        var index int32
+        while index < int32(properties.memoryTypeCount) {
+          if (memoryTypes[index].propertyFlags
+            &uint32(VkConstants.VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)) != 0u {
+              return true
+            }
+          index++
+        }
+        return false
+      }
+  }
