+internal unsafe partial class VulkanPrimitiveFrameData {
+  private func WriteHistoryCandidateForTest(
+    slot VulkanPrimitiveFrameSlot, count int32, changedRecord int32) {
+      let record = [32]uint32
+      var recordIndex int32 = 0
+      while recordIndex < count {
+        let firstWord = recordIndex * 32
+        var wordIndex int32 = 0
+        while wordIndex < 32 {
+          record[wordIndex] = slot.HistoryWords[firstWord + wordIndex]
+          wordIndex++
+        }
+        if recordIndex == changedRecord {
+          record[0] = record[0] ^ 0xffffffffu
+        }
+        WriteRecord(recordIndex, *void(&record[0]))
+        recordIndex++
+      }
+    }
+
+  private func RequireMappedHistoryForTest(
+    slot VulkanPrimitiveFrameSlot, count int32, label string) {
+      let mapped = *uint32(nint(slot.Mapped))
+      var wordIndex int32 = 0
+      while wordIndex < count * 32 {
+        if mapped[wordIndex] != slot.HistoryWords[wordIndex] {
+          throw InvalidOperationException(label + " did not restore submitted history")
+        }
+        wordIndex++
+      }
+    }
+
