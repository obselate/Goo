+        WriteEffectData([0]uint8, 0)
+        FinishPrepare()
+        if lastStats.FullUpload || lastStats.DirtyRecordCount != 1
+          || lastStats.CpuWrittenBytes != 128uL || lastStats.CpuWriteOperations != 1uL {
+            throw InvalidOperationException("Primitive abort fixture did not stage one dirty record")
+          }
+        Abort(slotIndex)
+
+        BeginPrepare(slotIndex, uint64(historyCount), 0, 0uL, completedSubmissionSerial)
+        WriteHistoryCandidateForTest(slot, historyCount, sparseRecord)
+        WriteEffectData([0]uint8, 0)
+        FinishPrepare()
+        let mappedAfterAbort = *uint32(nint(slot.Mapped))
+        let corruptedWord = corruptedRecord * 32
+        if lastStats.FullUpload || lastStats.DirtyRecordCount != 1
+          || lastStats.UploadRangeCount != 1 || lastStats.PlannedTransferBytes != 128uL
+          || lastStats.CpuWrittenBytes != 128uL || lastStats.CpuWriteOperations != 1uL
+          || mappedAfterAbort[corruptedWord] == slot.HistoryWords[corruptedWord]{
+            throw InvalidOperationException("Primitive sparse prepare did not preserve submitted history semantics after abort")
+          }
+        Abort(slotIndex)
+
+        let shrinkCount = historyCount - 1
+        BeginPrepare(slotIndex, uint64(historyCount), 0, 0uL, completedSubmissionSerial)
+        WriteHistoryCandidateForTest(slot, shrinkCount, -1)
+        WriteEffectData([0]uint8, 0)
+        FinishPrepare()
+        if !lastStats.FullUpload || lastStats.DirtyRecordCount != shrinkCount
+          || lastStats.PlannedTransferBytes != uint64(shrinkCount) * 128uL
+          || lastStats.CpuWrittenBytes != uint64(shrinkCount) * 128uL
