<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Goo" HintPath="/tmp/goo-glass-aa/runtime/Goo.dll" />
    <Reference Include="Goo.Gallery" HintPath="/tmp/goo-glass-aa/runtime/Goo.Gallery.dll" />
    <Reference Include="Hexa.NET.SDL3" HintPath="/tmp/goo-glass-aa/runtime/Hexa.NET.SDL3.dll" />
    <Content Include="/tmp/goo-glass-aa/runtime/**/*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
