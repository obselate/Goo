+    +" no_premature_completion=" + (if pendingVerified { "1" } else { "0" })
+    +" cpu_mailbox=" + (if mailboxVerified { "1" } else { "0" })
+    +" pixels=" + (if pixelsVerified { "1" } else { "0" }) + " cleanup=1")
+}
