<Project Sdk="Gsharp.NET.Sdk/0.4.1">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GooShowcase</RootNamespace>
    <AssemblyName>Goo.Showcase</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ShowcaseAssemblyInfo.gs" />
    <GooShaderEffect Include="Shaders/liquid_glass.frag.glsl"
                     TargetPath="liquid_glass.frag.spv" />
    <ProjectReference Include="../../Goo/Goo.gsproj"
                      Targets="Rebuild"
                      AdditionalProperties="Configuration=Showcase$(Configuration);IncludeTestFixtures=true;GooTestFixturesProps=$(MSBuildProjectDirectory)/Goo.ShowcaseFixtures.props" />
  </ItemGroup>
  <Import Project="../../Goo/Goo.targets" />
</Project>
