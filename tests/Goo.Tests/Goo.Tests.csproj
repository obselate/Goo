<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Goo\Goo.gsproj"
                      AdditionalProperties="Configuration=Test$(Configuration);IncludeTestFixtures=true" />
    <ProjectReference Include="..\..\Goo.InternalTextInterop\Goo.InternalTextInterop.csproj"
                      AdditionalProperties="Configuration=Test$(Configuration)" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Contracts\PublicApi.approved.txt"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="PublicApi.approved.txt" />
    <Compile Remove="Infrastructure\InteropFixtureAssemblyInfo.cs" />
  </ItemGroup>
  <Target Name="UseGooLinuxSdlForTests"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(GooLinuxSdlPath)' != '' and Exists('$(GooLinuxSdlPath)')">
    <Copy SourceFiles="$(GooLinuxSdlPath)"
          DestinationFiles="$(TargetDir)runtimes/linux-x64/native/libSDL3.so" />
  </Target>
</Project>
