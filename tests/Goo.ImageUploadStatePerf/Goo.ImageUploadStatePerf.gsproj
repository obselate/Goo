<Project Sdk="Gsharp.NET.Sdk/0.4.1">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GooImageUploadStatePerf</RootNamespace>
    <AssemblyName>Goo.Tests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ImageUploadStatePerfFixture.gs" />
    <ProjectReference Include="../../Goo/Goo.gsproj"
                      AdditionalProperties="Configuration=Test$(Configuration);IncludeTestFixtures=true;GooTestFixturesProps=$(MSBuildProjectDirectory)/Goo.ImageUploadStatePerfFixtures.props" />
  </ItemGroup>
  <Target Name="UseGooLinuxSdlForImageUploadStatePerf"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(GooLinuxSdlPath)' != '' and Exists('$(GooLinuxSdlPath)')">
    <Copy SourceFiles="$(GooLinuxSdlPath)"
          DestinationFiles="$(TargetDir)libSDL3.so" />
  </Target>
</Project>
