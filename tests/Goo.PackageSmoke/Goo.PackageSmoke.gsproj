<Project Sdk="Gsharp.NET.Sdk/0.4.1">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GooPackageSmoke</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/S09RScene.gs" Link="S09RScene.gs" />
    <PackageReference Include="Goo" Version="0.2.0" />
    <Content Include="../../proofs/Goo.VulkanProof/Assets/Text/VendSans-VariableFont_wght.ttf"
             Link="VendSans-VariableFont_wght.ttf"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../proofs/Goo.VulkanProof/Assets/Text/HarfBuzz-adwaita-colrv1.ttf"
             Link="HarfBuzz-adwaita-colrv1.ttf"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../proofs/Goo.VulkanProof/Assets/Text/HarfBuzz-TTC.ttc"
             Link="HarfBuzz-TTC.ttc"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../proofs/Goo.VulkanProof/Assets/Text/HarfBuzz-cff-f1.otf"
             Link="HarfBuzz-cff-f1.otf"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../proofs/Goo.VulkanProof/Assets/Text/HarfBuzz-cff-f2.otf"
             Link="HarfBuzz-cff-f2.otf"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../proofs/Goo.VulkanProof/Assets/Text/HarfBuzz-cff.otc"
             Link="HarfBuzz-cff.otc"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../proofs/Goo.VulkanProof/Assets/Text/HarfBuzz-cff-style-regular.otf"
             Link="HarfBuzz-cff-style-regular.otf"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../proofs/Goo.VulkanProof/Assets/Text/HarfBuzz-cff-style-bold.otf"
             Link="HarfBuzz-cff-style-bold.otf"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../proofs/Goo.VulkanProof/Assets/Text/HarfBuzz-cff-style-italic.otf"
             Link="HarfBuzz-cff-style-italic.otf"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
