<Project Sdk="Gsharp.NET.Sdk/0.4.1">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GooPackageSmoke</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Goo" Version="0.2.0" />
    <Content Include="../../proofs/Goo.VulkanProof/Assets/Text/VendSans-VariableFont_wght.ttf"
             Link="VendSans-VariableFont_wght.ttf"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../proofs/Goo.VulkanProof/Assets/Text/HarfBuzz-adwaita-colrv1.ttf"
             Link="HarfBuzz-adwaita-colrv1.ttf"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
