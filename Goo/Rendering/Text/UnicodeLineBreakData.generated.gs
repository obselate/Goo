    internal func Classify(value int32) TextLineBreakClass {
      var low int32 = 0
      var high = ranges.Length - 1
      while low <= high {
        let middle = low + (high - low) / 2
        let current = ranges[middle]
        if value < current.Start {
          high = middle - 1
        } else if value > current.End {
          low = middle + 1
        } else {
          return current.Class
        }
      }
      return TextLineBreakClass.XX
    }
