      UnicodeGraphemeRange(0xE0080, 0xE00FF, UnicodeGraphemeClass.Control, UnicodeGraphemeInCB.None, false),
      UnicodeGraphemeRange(0xE0100, 0xE01EF, UnicodeGraphemeClass.Extend, UnicodeGraphemeInCB.Extend, false),
      UnicodeGraphemeRange(0xE01F0, 0xE0FFF, UnicodeGraphemeClass.Control, UnicodeGraphemeInCB.None, false),
    }

    internal func Classify(value int32) UnicodeGraphemeInfo {
      var low int32 = 0
      var high = ranges.Length - 1
      while low <= high {
        let middle = low + (high - low) / 2
        let current = ranges[middle]
        if value < current.Start {
          high = middle - 1
        } else if value > current.End {
          low = middle + 1
        } else {
          return UnicodeGraphemeInfo(current.Class, current.InCB, current.ExtendedPictographic)
        }
      }
      return UnicodeGraphemeInfo(UnicodeGraphemeClass.Other, UnicodeGraphemeInCB.None, false)
    }
  }
}
