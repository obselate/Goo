    internal func Contains(value int32, script uint32) bool {
      let index = Find(value)
      if index < 0 { return UnicodeScriptsData.Classify(value) == script }
      let entry = ranges[index]
      var offset = entry.Offset
      let end = offset + entry.Count
      while offset < end {
        if tags[offset] == script { return true }
        offset++
      }
      return false
    }

    internal func AllowsAny(value int32) bool {
      let index = Find(value)
      if index < 0 {
        let script = UnicodeScriptsData.Classify(value)
        return script == UnicodeScriptsData.CommonTag || script == UnicodeScriptsData.InheritedTag
      }
      let entry = ranges[index]
      var offset = entry.Offset
      let end = offset + entry.Count
      while offset < end {
        if tags[offset] == UnicodeScriptsData.CommonTag || tags[offset] == UnicodeScriptsData.InheritedTag { return true }
        offset++
      }
      return false
    }

    private func Find(value int32) int32 {
      var low int32 = 0
      var high = ranges.Length - 1
      while low <= high {
        let middle = low + (high - low) / 2
        let current = ranges[middle]
        if value < current.Start {
          high = middle - 1
        } else if value > current.End {
          low = middle + 1
        } else {
          return middle
        }
      }
      return -1
    }
