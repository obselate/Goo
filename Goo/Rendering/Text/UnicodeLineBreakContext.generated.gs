      UnicodeLineBreakContextRange(0x1FACE, 0x1FADC, uint8(9)),
      UnicodeLineBreakContextRange(0x1FADD, 0x1FADE, uint8(24)),
      UnicodeLineBreakContextRange(0x1FADF, 0x1FAE9, uint8(9)),
      UnicodeLineBreakContextRange(0x1FAEA, 0x1FAEF, uint8(24)),
      UnicodeLineBreakContextRange(0x1FAF0, 0x1FAF8, uint8(9)),
      UnicodeLineBreakContextRange(0x1FAF9, 0x1FAFF, uint8(24)),
      UnicodeLineBreakContextRange(0x1FC00, 0x1FFFD, uint8(24)),
      UnicodeLineBreakContextRange(0x20000, 0x2FFFD, uint8(1)),
      UnicodeLineBreakContextRange(0x30000, 0x3FFFD, uint8(1)),
      UnicodeLineBreakContextRange(0xE0100, 0xE01EF, uint8(32)),
    }

    internal func Classify(value int32) uint8 {
      var low int32 = 0
      var high = ranges.Length - 1
      while low <= high {
        let middle = low + (high - low) / 2
        let current = ranges[middle]
        if value < current.Start {
          high = middle - 1
        } else if value > current.End {
          low = middle + 1
        } else {
          return current.Flags
        }
      }
      return uint8(0)
    }
  }
}
