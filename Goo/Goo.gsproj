<Project Sdk="Gsharp.NET.Sdk/0.3.633">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Goo</RootNamespace>
    <PackageId>Goo</PackageId>
    <Version>0.1.0</Version>
    <Authors>Xaz</Authors>
    <Description>A retained, declarative UI framework for G#.</Description>
    <PackageTags>gsharp;ui;gui;declarative;retained</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial retained UI release. See the packaged CHANGELOG.md for the supported surface and limitations.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/obselate/Goo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/obselate/Goo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildProjectDirectory)/../Goo.InternalTextInterop/Goo.InternalTextInterop.csproj"
                      PrivateAssets="all"
                      GlobalPropertiesToRemove="IncludeTestFixtures" />
    <ProjectReference Include="$(MSBuildProjectDirectory)/../vendor/Yoga.Net/src/Yoga.Net/Yoga.Net.csproj"
                      PrivateAssets="all" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="Hexa.NET.SDL3" ExcludeAssets="native" />
    <PackageReference Include="Unicode.Bidi" />
  </ItemGroup>
  <Import Project="../tests/Goo.Tests/Goo.TestFixtures.props"
          Condition="'$(IncludeTestFixtures)' == 'true'" />
  <Import Project="Goo.Packaging.targets" />
</Project>
