<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Goo.InternalTextInterop</AssemblyName>
    <RootNamespace>Goo.InternalTextInterop</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.116.0" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.116.0" />
    <PackageReference Include="HarfBuzzSharp" Version="14.2.1.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.1" />
    <PackageReference Include="Hexa.NET.SDL3" Version="1.2.17" />
    <PackageReference Include="Unicode.Bidi" Version="0.3.18" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'TestDebug' or '$(Configuration)' == 'TestRelease'">
    <Compile Include="../tests/Goo.Tests/Infrastructure/InteropFixtureAssemblyInfo.cs"
             Link="InteropFixtureAssemblyInfo.cs" />
  </ItemGroup>
</Project>
