# Public repository allowlist: Goo source, tests, documentation, automation, and release files.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/.agents/
!/.agents/skills/
!/.agents/skills/resolve-goo-issue/
!/.agents/skills/resolve-goo-issue/**
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
!/.github/workflows/label-issues.yml
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/**
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/dependabot.yml
!/.github/RELEASING.md
!/.github/scripts/
/.github/scripts/*
!/.github/scripts/build-sdl-linux-x64.sh
!/.github/scripts/stage-linux-x64.sh
!/.github/scripts/validate-release.py
!/.github/scripts/validate-readme-examples.py
!/.github/scripts/with-headless-wayland.sh

!/Goo/
!/Goo/**
!/Goo.InternalTextInterop/
!/Goo.InternalTextInterop/**

!/tests/
!/tests/**
/tests/GooExtended.Tests/

!/docs/
/docs/*
!/docs/assets/
!/docs/assets/**
!/docs/api/
!/docs/api/**

!/tools/
/tools/*
!/tools/Goo.ApiDocs/
!/tools/Goo.ApiDocs/**

!/probes/
/probes/*
!/probes/Findings/
!/probes/Findings/**

!/vendor/
/vendor/*
!/vendor/Yoga.Net/
/vendor/Yoga.Net/*
!/vendor/Yoga.Net/LICENSE
!/vendor/Yoga.Net/UPSTREAM.md
!/vendor/Yoga.Net/src/
!/vendor/Yoga.Net/src/**

!/README.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/NuGet.Config
!/LICENSE
!/THIRD-PARTY-NOTICES.md
!/Directory.Build.props
!/Directory.Packages.props

**/bin/
**/obj/
**/artifacts/
*.user
*.lscache
