# Public repository allowlist: Goo source, tests, API documentation, and CI only.
/*
!/.gitignore
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
!/.github/scripts/
/.github/scripts/*
!/.github/scripts/build-sdl-linux-x64.sh
!/.github/scripts/stage-linux-x64.sh
!/.github/scripts/validate-release.py
!/.github/scripts/validate-readme-examples.py
!/.github/scripts/with-headless-wayland.sh

!/Goo/
!/Goo/**
!/Goo.InternalTextInterop/
!/Goo.InternalTextInterop/**

!/tests/
!/tests/**

!/docs/
/docs/*
!/docs/assets/
!/docs/assets/**
!/docs/api/
!/docs/api/**

!/tools/
/tools/*
!/tools/Goo.ApiDocs/
!/tools/Goo.ApiDocs/**

!/vendor/
/vendor/*
!/vendor/Yoga.Net/
/vendor/Yoga.Net/*
!/vendor/Yoga.Net/LICENSE
!/vendor/Yoga.Net/UPSTREAM.md
!/vendor/Yoga.Net/src/
!/vendor/Yoga.Net/src/**

!/README.md
!/CHANGELOG.md
!/NuGet.Config
!/LICENSE
!/THIRD-PARTY-NOTICES.md
!/Directory.Build.props

**/bin/
**/obj/
**/artifacts/
*.user
*.lscache
