!/.github/workflows/ci.yml
!/.github/workflows/label-issues.yml
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/**
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/dependabot.yml
!/.github/RELEASING.md
!/.github/scripts/
/.github/scripts/*
!/.github/scripts/build-sdl-linux-x64.sh
!/.github/scripts/stage-linux-x64.sh
!/.github/scripts/validate-release.py
!/.github/scripts/validate-readme-examples.py
!/.github/scripts/with-headless-wayland.sh

!/Goo/
!/Goo/**
!/Goo.InternalTextInterop/
!/Goo.InternalTextInterop/**

!/tests/
!/tests/**
/tests/GooExtended.Tests/

!/docs/
/docs/*
!/docs/assets/
!/docs/assets/**
!/docs/api/
!/docs/api/**
!/docs/audits/
/docs/audits/*
!/docs/audits/2026-08-16-gsharp-0.4.1-findings.md
!/docs/audits/2026-08-16-vulkan-capability-census.md
!/docs/audits/2026-08-16-goo-core-requirements.md
!/docs/perf/
/docs/perf/*
!/docs/perf/2026-08-16-gsharp-0.4.1-skia-baseline-status.md
!/docs/perf/q10-workloads-v1.json
!/docs/plans/
/docs/plans/*
!/docs/plans/2026-08-16-gaps-and-reductions-working-state.md

!/tools/
/tools/*
!/tools/Goo.ApiDocs/
!/tools/Goo.ApiDocs/**
!/tools/Goo.VulkanGen/
!/tools/Goo.VulkanGen/**

!/proofs/
/proofs/*
!/proofs/Goo.VulkanProof/
!/proofs/Goo.VulkanProof/**

!/probes/
/probes/*
