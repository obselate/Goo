<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Goo.Q10TextBenchmark</AssemblyName>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <SelfContained Condition="'$(PublishAot)' == 'true'">true</SelfContained>
    <PublishTrimmed Condition="'$(PublishAot)' == 'true'">true</PublishTrimmed>
    <PublishAotUsingRuntimePack Condition="'$(PublishAot)' == 'true'">true</PublishAotUsingRuntimePack>
    <StripSymbols Condition="'$(PublishAot)' == 'true'">true</StripSymbols>
    <IlcOptimizationPreference Condition="'$(PublishAot)' == 'true'">Speed</IlcOptimizationPreference>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Goo.Benchmarking/Goo.Benchmarking.csproj" />
    <ProjectReference Include="../../Goo/Goo.gsproj" />
  </ItemGroup>
</Project>
